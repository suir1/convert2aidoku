fn select_readable_api_domain(source: &{{ source_struct }}) {
	let candidates = [{% for domain in api_domain_setting.candidates %}{{ domain | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}];
	for domain in candidates {
		defaults_set({{ api_domain_setting.key | tojson }}, DefaultValue::String(domain.into()));
		let Ok(result) = source.get_search_manga_list({{ query_expression }}, 1, Vec::new()) else {
			continue;
		};
		let Some(candidate) = result.entries.into_iter().next() else {
			continue;
		};
		let Ok(updated) = source.get_manga_update(candidate, true, true) else {
			continue;
		};
		let Some(chapter) = updated
			.chapters
			.as_ref()
			.and_then(|chapters| chapters.first())
			.cloned()
		else {
			continue;
		};
		if !updated.title.is_empty()
			&& matches!(source.get_page_list(updated, chapter), Ok(pages) if !pages.is_empty())
		{
			return;
		}
	}
	panic!("no configured API domain produced readable manga");
}

fn select_listing_api_domain(source: &{{ source_struct }}) {
	let candidates = [{% for domain in api_domain_setting.candidates %}{{ domain | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}];
	for domain in candidates {
		defaults_set({{ api_domain_setting.key | tojson }}, DefaultValue::String(domain.into()));
		if matches!(
			source.get_search_manga_list(None, 1, Vec::new()),
			Ok(result) if !result.entries.is_empty()
		) {
			return;
		}
	}
	panic!("no configured API domain produced a manga list");
}
