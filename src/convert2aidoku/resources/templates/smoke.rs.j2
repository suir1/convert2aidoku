use super::{{ source_struct }};
use aidoku::{PageContent, Source, alloc::{String, Vec{% if static_filter_cases or dynamic_filters %}, vec{% endif %}}{% if static_filter_cases or dynamic_filters %}, FilterValue{% endif %}{% if listing_provider %}, Listing, ListingProvider{% endif %}{% if dynamic_filters %}, DynamicFilters, FilterKind{% endif %}{% if deep_link_handler %}, DeepLinkHandler{% endif %}{% if not image_request_provider %}, imports::net::Request{% endif %}};
