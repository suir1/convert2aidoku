#[aidoku_test]
fn generated_static_filters_live_smoke() {
	let source = {{ source_struct }}::new();
	{% if api_domain_setting %}select_listing_api_domain(&source);
	{% endif %}
	let cases: Vec<(&str, Vec<FilterValue>)> = vec![
		{% for case in static_filter_cases %}
		({{ case.id | tojson }}, vec![
			{% if case.kind == "select" %}
			FilterValue::Select {
				id: {{ case.id | tojson }}.into(),
				value: {{ case.value | tojson }}.into(),
			},
			{% elif case.kind == "sort" %}
			FilterValue::Sort {
				id: {{ case.id | tojson }}.into(),
				index: {{ case.index }},
				ascending: {{ "true" if case.ascending else "false" }},
			},
			{% endif %}
		]),
		{% endfor %}
	];
	for (filter_id, filters) in cases {
		let result = source
			.get_search_manga_list(None, 1, filters)
			.unwrap_or_else(|error| panic!("static filter {filter_id} request failed: {error:?}"));
		assert!(!result.entries.is_empty(), "static filter {filter_id} returned no manga");
		assert!(
			result
				.entries
				.iter()
				.all(|entry| !entry.title.trim().is_empty()),
			"static filter {filter_id} returned a manga with an empty title"
		);
	}
}
{% endif %}
