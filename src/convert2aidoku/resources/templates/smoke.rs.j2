fn select_readable_api_domain() -> {{ source_struct }} {
	let candidates = [{% for domain in api_domain_setting.candidates %}{{ domain | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}];
	let mut attempted = String::new();
	for domain in candidates {
		if !attempted.is_empty() {
			attempted.push_str(", ");
		}
		attempted.push_str(domain);
		defaults_set({{ api_domain_setting.key | tojson }}, DefaultValue::String(domain.into()));
		let source = {{ source_struct }}::new();
		let mut manga_candidates = Vec::new();
		{% if listing_provider and popular_listing %}
		if let Ok(result) = source.get_manga_list(
			Listing { id: "popular".into(), name: "Popular".into(), ..Default::default() },
			1,
		) {
			manga_candidates.extend(result.entries);
		}
		{% endif %}
		if manga_candidates.is_empty()
			&& let Ok(result) = source.get_search_manga_list({{ query_expression }}, 1, Vec::new())
		{
			manga_candidates.extend(result.entries);
		}
		{% if listing_provider and latest_listing %}
		if manga_candidates.is_empty()
			&& let Ok(result) = source.get_manga_list(
			Listing { id: "latest".into(), name: "Latest".into(), ..Default::default() },
			1,
		) {
			manga_candidates.extend(result.entries);
		}
		{% endif %}
		if manga_candidates.is_empty() {
			attempted.push_str(" (empty listings)");
			continue;
		}
		let mut domain_failure = " (no readable candidate)";
		for candidate in manga_candidates.into_iter().take(12) {
			let updated = match source.get_manga_update(candidate, true, true) {
				Ok(updated) => updated,
				Err(_) => {
					domain_failure = " (update error)";
					continue;
				}
			};
			let Some(chapter) = updated
				.chapters
				.as_ref()
				.and_then(|chapters| chapters.first())
				.cloned()
			else {
				domain_failure = " (no chapters)";
				continue;
			};
			if updated.title.is_empty() {
				domain_failure = " (empty title)";
				continue;
			}
			match source.get_page_list(updated, chapter) {
				Ok(pages) if !pages.is_empty() => return source,
				Ok(_) => domain_failure = " (empty pages)",
				Err(_) => domain_failure = " (pages error)",
			}
		}
		attempted.push_str(domain_failure);
	}
	panic!("no configured API domain produced readable manga: {}", attempted);
}

fn select_listing_api_domain() -> {{ source_struct }} {
	let candidates = [{% for domain in api_domain_setting.candidates %}{{ domain | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}];
	for domain in candidates {
		defaults_set({{ api_domain_setting.key | tojson }}, DefaultValue::String(domain.into()));
		let source = {{ source_struct }}::new();
		if matches!(
			source.get_search_manga_list(None, 1, Vec::new()),
			Ok(result) if !result.entries.is_empty()
		) {
			return source;
		}
	}
	panic!("no configured API domain produced a manga list");
}
